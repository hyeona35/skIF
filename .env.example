# Principal tokens — keep these different in production.
SKIF_HOST_TOKEN=change-me-host
SKIF_AGENT_TOKEN=change-me-agent
SKIF_USER_TOKEN=change-me-user

# Optional cryptographic keys.
# Generate strong random values and keep them outside the repository.
SKIF_FEDERATION_KEY=
SKIF_IDENTITY_KEY=
SKIF_TELEMETRY_KEY=

# Optional provider credentials are configured by provider.api_key_env in ~/.skif/config.json.
