{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skIF Agent Contribution",
  "type": "object",
  "required": ["agent_id", "skill", "kind", "evidence"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "skill": {"type": "string", "minLength": 1, "maxLength": 300},
    "kind": {"enum": ["telemetry", "feedback", "vote", "error", "patch", "methodology", "proposal", "eval"]},
    "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
